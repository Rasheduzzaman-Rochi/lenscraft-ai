# Copy to backend/.env for local development.
APP_NAME=lenscraft-backend
ENVIRONMENT=development

# Required for the database diagnostic; health works without these.
# Use your Supabase project HTTP URL, not a PostgreSQL connection string.
SUPABASE_URL=
# Server-only secret/service_role key; the migrations deny anon table access.
SUPABASE_KEY=
SUPABASE_TIMEOUT_SECONDS=10
# Fixed company UUID for admin, website-form, and webhook processing.
AGENT_COMPANY_ID=

# Server-side credential for internal/admin API access. Use a strong random value.
ADMIN_API_KEY=

# Verifies signed website-form requests and the optional Retell webhook.
# FastAPI is not part of the voice-agent runtime; Retell calls Supabase RPCs directly.
RETELL_API_KEY=
# Maximum accepted Retell webhook signature age in seconds.
RETELL_WEBHOOK_TOLERANCE_SECONDS=300
OPENAI_API_KEY=

LOG_LEVEL=INFO
# JSON array of exact frontend origins. Default without configuration is [].
CORS_ORIGINS=["http://localhost:3000"]
