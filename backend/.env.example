# Copy to backend/.env for local development.
APP_NAME=lenscraft-backend
ENVIRONMENT=development

# Required for the database diagnostic; health works without these.
# Use your Supabase project HTTP URL, not a PostgreSQL connection string.
SUPABASE_URL=
# Server-only secret/service_role key; the migrations deny anon table access.
SUPABASE_KEY=
SUPABASE_TIMEOUT_SECONDS=10
# Existing company UUID for development/testing transcript processing.
AGENT_COMPANY_ID=

# Reserved for future integrations.
RETELL_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=INFO
# JSON array of exact frontend origins. Default without configuration is [].
CORS_ORIGINS=["http://localhost:3000"]
