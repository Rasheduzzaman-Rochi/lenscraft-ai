# Copy to backend/.env for local development.
APP_NAME=lenscraft-backend
ENVIRONMENT=development

# Optional placeholders: no integrations are initialized yet.
SUPABASE_URL=
SUPABASE_KEY=
RETELL_API_KEY=
OPENAI_API_KEY=

LOG_LEVEL=INFO
# JSON array of exact frontend origins. Default without configuration is [].
CORS_ORIGINS=["http://localhost:3000"]
