# Docker Compose configuration reference.
# Copy to .env for local Compose use. Supply production values through Dokploy.
# Never commit real credentials.

APP_NAME=lenscraft-backend
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Frontend: public and visible to browser users.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend only: Supabase project API credentials.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=
SUPABASE_TIMEOUT_SECONDS=10

# Existing tenant and Retell request verification.
AGENT_COMPANY_ID=
RETELL_API_KEY=
RETELL_WEBHOOK_TOLERANCE_SECONDS=300

# Reserved for the future embedding provider integration.
OPENAI_API_KEY=

# Migration tooling only; the application and Compose service do not consume it.
DATABASE_URL=postgresql://your-user:your-password@your-database-host:5432/postgres?sslmode=require
