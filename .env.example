# Docker Compose configuration reference for the FastAPI backend service.
# Copy to .env for local Compose use. Supply production values through Dokploy.
# Never commit real credentials.
#
# Architecture: FastAPI serves the Admin Dashboard (/api/v1/admin) and the
# website's /booking and /contact forms. It is NOT part of the voice-agent
# runtime: the website starts calls with Retell directly, and the Retell
# Conversation Flow calls Supabase RPCs directly. See frontend/.env.example for
# the Next.js service's variables.

APP_NAME=lenscraft-backend
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# FastAPI origin as configured on the Next.js service (server-side use only;
# not a secret despite the historical NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend only: Supabase project URL and service-role key. Never expose the key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=
SUPABASE_TIMEOUT_SECONDS=10

# Shared server-only credential for FastAPI admin endpoints and the Next.js
# admin proxy. Configure the same value in both deployed services.
ADMIN_API_KEY=

# Fixed tenant UUID; must equal LENSCRAFT_COMPANY_ID on the Next.js service.
AGENT_COMPANY_ID=
# Server-only. Verifies the signed website form requests (and the optional
# post-call webhook). The Retell x-agent-secret for Supabase RPCs is configured
# only inside Retell and never belongs here.
RETELL_API_KEY=
RETELL_WEBHOOK_TOLERANCE_SECONDS=300

# Reserved for the future embedding provider integration.
OPENAI_API_KEY=

# Migration tooling only; the application and Compose service do not consume it.
DATABASE_URL=postgresql://your-user:your-password@your-database-host:5432/postgres?sslmode=require
