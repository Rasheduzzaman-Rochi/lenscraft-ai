# Configuration reference only; services are not yet implemented.
# Copy to .env for local use. Never commit real credentials.
# Production values should be supplied through Dokploy.

# Frontend: public and visible to browser users.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend only: Supabase project and PostgreSQL connection.
# Copy the appropriate connection URL from your Supabase project settings.
SUPABASE_URL=https://your-project-ref.supabase.co
DATABASE_URL=postgresql://your-user:your-password@your-database-host:5432/postgres?sslmode=require

# Backend only: populate if privileged Supabase API access is required.
# Never expose this value through NEXT_PUBLIC_ variables or frontend code.
SUPABASE_SERVICE_ROLE_KEY=
