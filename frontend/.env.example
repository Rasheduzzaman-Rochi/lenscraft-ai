# Public FastAPI origin. This value is safe to include in the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Supabase project URL used to build lenscraft-media Storage URLs.
NEXT_PUBLIC_SUPABASE_URL=
# Public browser-safe anon key used by Supabase Auth.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public Retell agent identifier. This is an identifier, not an API secret.
NEXT_PUBLIC_RETELL_AGENT_ID=

# Server-only values used by Next.js route handlers. Never prefix these with NEXT_PUBLIC_.
ADMIN_API_KEY=
LENSCRAFT_COMPANY_ID=
RETELL_API_KEY=
