# Public FastAPI origin. This value is safe to include in the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Retell voice agent identifier. This is not an API credential.
NEXT_PUBLIC_RETELL_AGENT_ID=

# Server-only values used by Next.js route handlers. Never prefix these with NEXT_PUBLIC_.
RETELL_API_KEY=
LENSCRAFT_COMPANY_ID=
# Human login credential checked only by the Next.js server.
ADMIN_LOGIN_PASSWORD=
# Must match the backend ADMIN_API_KEY; used only for server-to-server requests.
ADMIN_API_KEY=
# At least 32 random characters. Keep separate from the backend admin API key.
ADMIN_SESSION_SECRET=
