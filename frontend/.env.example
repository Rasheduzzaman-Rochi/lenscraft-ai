# LensCraft Studio Next.js service. Never commit populated values.
# Only NEXT_PUBLIC_* values may reach the browser; every other value is server-only.

# ---------------------------------------------------------------------------
# PUBLIC WEBSITE (browser-safe)
# ---------------------------------------------------------------------------
# Public Supabase project URL, used for Supabase Auth and lenscraft-media Storage URLs.
NEXT_PUBLIC_SUPABASE_URL=
# Public browser-safe anon/publishable key, used only for Supabase Auth.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# VOICE AGENT: browser -> Retell directly
# ---------------------------------------------------------------------------
# Call path: browser -> /api/voice/session (creates a Retell web-call access token)
# -> Retell -> Retell Conversation Flow -> Supabase RPCs. FastAPI is not involved.
# Production Retell agent ID. It is an identifier, not a secret. It is read only by
# the server-side token route, and must be the current production Conversation Flow agent.
NEXT_PUBLIC_RETELL_AGENT_ID=
# Server-only Retell API key used to create web-call access tokens. It is also the
# signing key for the website forms below. Never expose it or prefix it with NEXT_PUBLIC_.
# The Retell custom-function secret (x-agent-secret) belongs only in Retell; never set it here.
RETELL_API_KEY=

# ---------------------------------------------------------------------------
# ADMIN DASHBOARD AND WEBSITE FORMS (server-only): Next.js server -> FastAPI
# ---------------------------------------------------------------------------
# FastAPI origin. Despite the historical NEXT_PUBLIC_ prefix, it is read only by server
# code at runtime and is not a secret. Used by the Admin Dashboard (/api/v1/admin) and by
# the /booking and /contact form handlers. The voice agent never uses it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Shared admin credential; must equal the backend's ADMIN_API_KEY.
ADMIN_API_KEY=
# Fixed company UUID; must equal the backend's AGENT_COMPANY_ID.
LENSCRAFT_COMPANY_ID=
